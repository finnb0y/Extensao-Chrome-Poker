{
  "manifest_version": 3,
  "name": "Poker Registro Extractor",
  "version": "1.0.0",
  "description": "Extrai registros e Obs da tabela de cash game em site de poker autorizado.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://poker.example.com/*"],
  "action": {
    "default_title": "Poker Registro Extractor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://poker.example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://poker.example.com/*"]
    }
  ]
}
